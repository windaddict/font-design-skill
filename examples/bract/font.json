      { "name": "plate", "background": "#fdfaf3", "foreground": "#241f19" },
      { "name": "cloth", "background": "#14301c", "foreground": "#f6f0df" }
    ],
    "comparison_faces": [{ "name": "Georgia", "family": "Georgia" }],
    "body_face": "Georgia"
  }
