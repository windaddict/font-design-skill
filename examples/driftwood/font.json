{
  "$comment": "The Driftwood example parameters: Driftwood (movingavg.com, 2026-11-14) re-expressed for this skill as a wght-only roman and a wght-only italic, each its own variable font. Driftwood shipped as five static CFF fonts from a union build; this is the same design through the variable pipeline, built and self-checked here but never design-reviewed in this form. Parameters only, MIT like the rest of the repo. The name table is neutral: the family is 'Driftwood Example' and the owner strings are placeholders, because the name Driftwood MA identifies the site's face and is not licensed for reuse as a font name (NOTICE.md). names.fs_type is 4 (Preview & Print), the usual setting for a proprietary face: the site this configuration came from licenses its font to that site only. typo_metrics is the precedent's override (hhea and typo both carry 760/-240, line gap 0).",
  "family": "Driftwood Example",
  "version": "1.000",
  "concepts": "concepts.js",
  "out_dir": "out",
  "groups": {
    "roman": {
      "italic": false,
      "axes": [
        { "tag": "wght", "name": "Weight", "min": 400, "default": 400, "max": 700, "map": [[400, 400], [500, 538], [700, 700]] }
      ],
      "masters": {
        "Regular": { "concept": "driftwood", "mult": 1, "location": { "wght": 400 } },
        "Bold": { "concept": "driftwood", "mult": 1.65, "location": { "wght": 700 } }
      },
      "instances": [
        { "name": "Regular", "location": { "wght": 400 } },
        { "name": "Medium", "location": { "wght": 500 } },
        { "name": "Bold", "location": { "wght": 700 } }
      ],
      "hairline_floors": { "Regular": 30, "Bold": 50 }
    },
    "italic": {
      "italic": true,
      "italic_angle": 10,
      "axes": [
        { "tag": "wght", "name": "Weight", "min": 400, "default": 400, "max": 500 }
      ],
      "masters": {
        "Regular": { "concept": "driftwood", "mult": 1, "location": { "wght": 400 } },
        "Medium": { "concept": "driftwood", "mult": 1.3, "location": { "wght": 500 } }
      },
      "instances": [
        { "name": "Italic", "location": { "wght": 400 } },
        { "name": "Medium Italic", "location": { "wght": 500 } }
      ],
      "hairline_floors": { "Regular": 30, "Medium": 39 }
    }
  },
  "charset": {
    "required": "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,':;!?-–—…()[]/&%$\"“”‘’©™•",
    "nbsp_to_space": true,
    "ascii_apostrophe_curly": true
  },
  "kerning": {
    "set": "^[A-Za-z0-9.,':;!?\\-–—…()\\[\\]/&%$©™•]$",
    "threshold": 8,
    "hand": { "A|I": -30, "I|A": -30, "L|T": -25, "L|V": -60, "L|Y": -60, "L|W": -45, "r|.": -50, "r|,": -50, "f|f": 0 },
    "space": [[" ", "A", -45], [" ", "T", -20], [" ", "V", -35], [" ", "W", -30], [" ", "Y", -30],
              ["A", " ", -30], ["V", " ", -30], ["W", " ", -25], ["Y", " ", -25], ["r", " ", -25]],
    "italic_hand": { "I|P": -45, "I|D": -35, "I|B": -35, "I|E": -35, "I|R": -35, "I|N": -30, "I|M": -30, "I|m": -25, "I|n": -25, "P|I": -20, "A|I": -40, "T|h": -100, "T|w": -130, "T|r": -130, "K|e": -120, "A|t": -30 },
    "italic_space": [["f", " ", -20], ["I", " ", -25], [" ", "I", -20]]
  },
  "titles": ["AI Agents Need an Org Chart", "Don't Hire a Fractional CTO", "Moving Average Inc."],
  "size_budget_bytes": 102400,
  "raster": { "budget": { "decimation": 48, "union": 48, "seam": 24 }, "sizes": [16, 40, 80] },
  "fold_units": { "raw": 4, "decimated": 10 },
  "decimation_eps": 1,
  "typo_metrics": { "ascender": 760, "descender": -240 },
  "names": {
    "fs_type": 4,
    "copyright": "Copyright {{year}} {{operator}}",
    "manufacturer": "{{operator}}",
    "designer": "{{operator}}",
    "vendor_id": "EXMP",
