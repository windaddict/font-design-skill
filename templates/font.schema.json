{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "font-design/font/v1",
  "title": "font.json: one project's font configuration",
  "description": "Everything site-specific about a face built with this skill lives here, not in the scripts: axes, masters, instances, floors, budgets, cmap decisions, kerning lists, name-table strings, review sizes and surfaces. templates/font.example.json documents every key. Paths are relative to this file's directory. Reviewed EXPECTATIONS live in a separate requirements.json (review finding F002), so a change here cannot make the tests agree with itself.",
  "type": "object",
  "required": ["family", "version", "concepts", "out_dir", "groups", "charset", "kerning", "size_budget_bytes", "names", "source_date_epoch"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "$schema": { "type": "string" },
    "family": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/:*?\"<>|]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
    "concepts": { "type": "string", "pattern": "\\.js$" },
    "out_dir": { "type": "string", "minLength": 1 },
    "manifest": { "type": "string", "description": "optional path for manifest.json; default <out_dir>/manifest.json" },
    "groups": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/group" }
    },
    "charset": {
      "type": "object", "required": ["required", "nbsp_to_space", "ascii_apostrophe_curly"], "additionalProperties": false,
      "properties": {
        "required": { "type": "string", "minLength": 1, "description": "every character the display face must set; export.js --requirements fails early if one has no skeleton" },
        "nbsp_to_space": { "type": "boolean" },
        "ascii_apostrophe_curly": { "type": "boolean", "description": "true: U+0027 draws the curly apostrophe and the straight tick stays unmapped" }
      }
    },
    "kerning": {
      "type": "object", "required": ["set", "threshold", "hand", "space"], "additionalProperties": false,
      "properties": {
        "set": { "type": "string", "description": "a regex matched against single-character generator keys; ligatures are always included" },
        "threshold": { "type": "number", "minimum": 0 },
        "hand": { "$ref": "#/$defs/handKerns" },
        "space": { "$ref": "#/$defs/spaceKerns" },
        "italic_hand": { "$ref": "#/$defs/handKerns" },
        "italic_space": { "$ref": "#/$defs/spaceKerns" }
      }
    },
    "titles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "real titles the kerning test lays at every master" },
    "size_budget_bytes": { "type": "integer", "minimum": 1024 },
    "raster": {
      "type": "object", "required": ["budget", "sizes"], "additionalProperties": false,
      "properties": {
        "budget": { "type": "object", "required": ["decimation", "union", "seam"], "additionalProperties": false,
          "properties": { "decimation": { "type": "integer", "minimum": 0, "maximum": 255 }, "union": { "type": "integer", "minimum": 0, "maximum": 255 }, "seam": { "type": "integer", "minimum": 0, "maximum": 255 } } },
        "sizes": { "type": "array", "items": { "type": "integer", "minimum": 4 }, "minItems": 1 }
      }
    },
    "fold_units": { "type": "object", "required": ["raw", "decimated"], "additionalProperties": false,
      "properties": { "raw": { "type": "number", "exclusiveMinimum": 0 }, "decimated": { "type": "number", "exclusiveMinimum": 0 } } },
    "decimation_eps": { "type": "number", "minimum": 0 },
    "typo_metrics": { "type": "object", "required": ["ascender", "descender"], "additionalProperties": false,
      "description": "optional override of the ascender and descender written to BOTH hhea and OS/2 typo; absent, both are the measured extent of every glyph. The line gap is 0 in both and cannot be set",
      "properties": { "ascender": { "type": "integer", "exclusiveMinimum": 0 }, "descender": { "type": "integer", "maximum": 0 }, "line_gap": { "const": 0 } } },
    "names": {
      "type": "object", "required": ["fs_type", "copyright", "manufacturer", "designer", "vendor_id", "vendor_url", "licence", "description"], "additionalProperties": false,
      "properties": {
        "fs_type": { "type": "integer", "enum": [0, 2, 4, 8, 256, 258, 260, 264],
          "description": "OS/2 fsType, the embedding permission; no default, the operator chooses with the licence. 0 installable (an open face), 4 Preview & Print (the usual setting for a proprietary face), 8 editable, 2 restricted (some tools refuse the font); +256 no subsetting (bitmap-only embedding, +512, is refused: this build writes no bitmaps). Browsers ignore it for web fonts" },
        "copyright": { "type": "string", "minLength": 1 }, "manufacturer": { "type": "string", "minLength": 1 }, "designer": { "type": "string", "minLength": 1 },
        "vendor_id": { "type": "string", "pattern": "^[A-Za-z0-9 ]{1,4}$" }, "vendor_url": { "type": "string", "pattern": "^https?://" },
        "licence": { "type": "string", "minLength": 1 }, "licence_url": { "type": "string", "pattern": "^https?://" }, "description": { "type": "string", "minLength": 1 }
      }
    },
    "source_date_epoch": { "type": "integer", "minimum": 0, "description": "head.created/modified; assigned unconditionally by build.py so the bytes never depend on who ran it" },
    "review": {
      "type": "object", "required": ["sizes", "surfaces"], "additionalProperties": false,
      "properties": {
        "sizes": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 1, "description": "CSS px the site sets the face at; specimen.py and diff.py render every one" },
        "medium_below_px": { "type": "number", "minimum": 0, "description": "sizes under this use weight 500 in the specimen (0: never)" },
        "surfaces": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "background", "foreground"], "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "foreground": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } } },
        "comparison_faces": { "type": "array", "items": { "type": "object", "required": ["name", "family"], "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "family": { "type": "string" }, "url": { "type": "string", "description": "optional woff2 path, relative to this file, served by shoot.py" }, "css_url": { "type": "string", "pattern": "^https?://" }, "weights": { "type": "array", "items": { "type": "integer" } } } } },
        "body_face": { "type": "string" },
        "wordmark": { "type": "string", "minLength": 1, "description": "the wordmark text the specimen sets in caps; default: the shortest title" }
      }
    }
  },
  "$defs": {
    "location": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-zA-Z]{4}$" }, "additionalProperties": { "type": "number" } },
    "axis": {
      "type": "object", "required": ["tag", "name", "min", "default", "max"], "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "pattern": "^[a-zA-Z]{4}$" }, "name": { "type": "string", "minLength": 1 },
        "min": { "type": "number" }, "default": { "type": "number" }, "max": { "type": "number" },
        "map": { "type": "array", "minItems": 2, "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "description": "avar: [user, design] pairs; must include both ends" }
      }
    },
    "master": {
      "type": "object", "required": ["concept", "mult", "location"], "additionalProperties": false,
      "properties": { "concept": { "type": "string", "minLength": 1 }, "mult": { "type": "number", "exclusiveMinimum": 0 }, "location": { "$ref": "#/$defs/location" } }
    },
    "instance": {
      "type": "object", "required": ["name", "location"], "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "location": { "$ref": "#/$defs/location" } }
    },
    "group": {
      "type": "object", "required": ["italic", "axes", "masters", "instances", "hairline_floors"], "additionalProperties": false,
      "properties": {
        "italic": { "type": "boolean" },
        "italic_angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "file": { "type": "string", "pattern": "\\.woff2$", "description": "optional output path; default <out_dir>/<Family>-VF.woff2 or <Family>-Italic-VF.woff2" },
        "axes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/axis" } },
        "masters": { "type": "object", "minProperties": 2, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9 ]*$" }, "additionalProperties": { "$ref": "#/$defs/master" } },
        "instances": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instance" } },
        "hairline_floors": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "number", "minimum": 0 }, "description": "minimum interior stroke width per master, in units; the build fails below it" }
      }
    },
    "handKerns": { "type": "object", "propertyNames": { "pattern": "^[^|]+\\|[^|]+$" }, "additionalProperties": { "type": "integer" } },
    "spaceKerns": { "type": "array", "items": { "type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{ "type": "string" }, { "type": "string" }, { "type": "integer" }] } }
  }
}
